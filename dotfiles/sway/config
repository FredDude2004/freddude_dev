exec --no-startup-id fcitx -d

default_border pixel 2
default_floating_border pixel 2

# Open Waybar's Bluetooth and Wi-Fi managers as centered floating windows
for_window [app_id="(?i)blueman-manager"] floating enable, resize set width 700 px height 500 px, move position center
for_window [class="(?i)blueman-manager"] floating enable, resize set width 700 px height 500 px, move position center

for_window [app_id="(?i)nm-connection-editor"] floating enable, resize set width 800 px height 600 px, move position center
for_window [class="(?i)nm-connection-editor"] floating enable, resize set width 800 px height 600 px, move position center

include '$(/usr/libexec/sway/layered-include "/usr/share/sway/config.d/*.conf" "/etc/sway/config.d/*.conf" "${XDG_CONFIG_HOME:-$HOME/.config}/sway/config.d/*.conf")'
