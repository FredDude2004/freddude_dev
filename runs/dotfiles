#!/usr/bin/env bash

set -euo pipefail

REPO_DIR="$HOME/Desktop/github.com/FredDude2004/freddude_dev"
DOTFILES_DIR="$REPO_DIR/dotfiles"
CONFIG_DIR="$HOME/.config"
BACKUP_DIR="$HOME/.config-backup-$(date +%Y%m%d-%H%M%S)"

# Clone the repository if it does not already exist.
if [[ ! -d "$REPO_DIR/.git" ]]; then
    mkdir -p "$(dirname "$REPO_DIR")"
    git clone \
        "https://github.com/FredDude2004/freddude_dev.git" \
        "$REPO_DIR"
fi

if [[ ! -d "$DOTFILES_DIR" ]]; then
    echo "Error: dotfiles directory not found: $DOTFILES_DIR" >&2
    exit 1
fi

mkdir -p "$CONFIG_DIR"

# Include normal and hidden entries, while ignoring . and ..
shopt -s dotglob nullglob

for source in "$DOTFILES_DIR"/*; do
    name="$(basename "$source")"
    target="$CONFIG_DIR/$name"

    # Skip Git metadata if the dotfiles directory itself is a repository.
    if [[ "$name" == ".git" ]]; then
        continue
    fi

    if [[ -L "$target" ]]; then
        echo "Replacing existing symlink: $target"
        rm "$target"
    elif [[ -e "$target" ]]; then
        mkdir -p "$BACKUP_DIR"
        echo "Backing up existing item: $target"
        mv "$target" "$BACKUP_DIR/$name"
    fi

    echo "Linking: $target -> $source"
    ln -s "$source" "$target"
done

echo
echo "Dotfiles linked successfully."

if [[ -d "$BACKUP_DIR" ]]; then
    echo "Existing configuration was backed up to:"
    echo "  $BACKUP_DIR"
fi

git clone https://github.com/FredDude2004/nvim ~/.config/nvim
